# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-key-here

# Optional: comma-separated models to try in order
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Optional: uses local SQLite if unset
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/codesynapse

# Optional: raises GitHub's hourly rate limit
# GITHUB_TOKEN=your-token-here

# Required when deployed: encrypts the browser's copy of the user token
# UI_SECRET=a-long-random-value

# Optional: model used for code search vectors
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional: "Sign in with GitHub". Create an OAuth App on GitHub (see docs/DEPLOY.md);
# all three are needed, otherwise the sign-in button stays hidden
# GITHUB_CLIENT_ID=your-client-id
# GITHUB_CLIENT_SECRET=your-client-secret
# PUBLIC_URL=http://localhost:7860
